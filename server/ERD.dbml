Ref: user_account.role_id > user_role.role_id
Ref: user_profile.user_account_id - user_account.user_account_id
Ref: refresh_token.user_account_id > user_account.user_account_id
Ref: customer_profile.fk_user_account_id - user_account.user_account_id
Ref: system_log.user_account_id > user_account.user_account_id

Ref: product.fk_category_id > product_category.pk_product_category_id
Ref: product.fk_color_id > product_color.pk_product_color_id
Ref: product.fk_material_id > product_material.pk_product_material_id
Ref: product.fk_room_id > product_room.pk_product_room_id
Ref: product_item.fk_product_id > product.pk_product_id
Ref: product_item.fk_order_item_id > order_item.pk_order_item_id
Ref: product_pricing.fk_product_id > product.pk_product_id

Ref: orders.fk_customer_id > customer_profile.pk_customer_id
Ref: orders.fk_user_account_id > user_account.user_account_id
Ref: order_item.fk_order_id > orders.pk_order_id
Ref: order_item.fk_product_id > product.pk_product_id
Ref: order_history.fk_order_id > orders.pk_order_id
Ref: order_item_processing.fk_order_item_id > order_item.pk_order_item_id
Ref: order_item_processing.fk_user_account_id > user_account.user_account_id

Ref: custom_request.fk_customer_id > customer_profile.pk_customer_id
Ref: custom_request.fk_order_id - orders.pk_order_id
Ref: custom_request_item.fk_custom_request_id > custom_request.pk_custom_request_id
Ref: custom_request_item.fk_supplier_id > supplier.pk_supplier_id
Ref: order_item.fk_custom_request_item_id - custom_request_item.pk_custom_request_item_id

Ref: coupon_product.fk_product_id > product.pk_product_id
Ref: coupon_product.fk_coupon_id > product_coupon.pk_coupon_id

Ref: employee.user_account_id > user_account.user_account_id
Ref: salary_record.fk_period_id > payroll_period.period_id
Ref: salary_record.fk_employee_id > employee.employee_id
Ref: salary_adjustment.fk_record_id > salary_record.record_id
Ref: notification.fk_user_id > user_account.user_account_id

Ref: manufacturing_order.fk_supplier_id > supplier.pk_supplier_id
Ref: manufacturing_order_item.fk_manufacturing_order_id > manufacturing_order.pk_manufacturing_order_id
Ref: manufacturing_order_item.fk_product_id > product.pk_product_id
Ref: manufacturing_order_item.fk_custom_request_item_id - custom_request_item.pk_custom_request_item_id
Ref: import_receipt.fk_manufacturing_order_id > manufacturing_order.pk_manufacturing_order_id

